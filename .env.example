APP_NAME="JE RELAIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=jerelais
DB_USERNAME=jerelais
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6390

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jerelais.ci"
MAIL_FROM_NAME="${APP_NAME}"

WAS_ACCESS_KEY=
WAS_SECRET_KEY=
WASABI_REGION=eu-central-1
WASABI_BUCKET=
WASABI_IDENTITY_BUCKET=
WASABI_ENDPOINT=https://s3.eu-central-1.wasabisys.com
WASABI_URL=

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8085
REVERB_SERVER_PORT=8085
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Plateforme JE RELAIS
# log : journal local · mailpit : SMS lisibles sur http://localhost:8025 (recette locale) · none : aucun envoi (production sans fournisseur) · mtarget : envoi réel par MTarget
SMS_DRIVER=mailpit
# Code OTP : 1234 automatiquement tant qu’aucun fournisseur de SMS réel n’est branché (log, mailpit, none),
# aléatoire et envoyé par SMS dès qu’il l’est. OTP_FIXED_CODE impose un autre code fixe, ou « off » pour le désactiver.
# OTP_FIXED_CODE_NUMBERS limite le code fixe à une liste de numéros (séparés par des virgules) ; vide = tous les numéros.
OTP_FIXED_CODE=
OTP_FIXED_CODE_NUMBERS=
SMS_SENDER="JE RELAIS"
# MTarget (SMS_DRIVER=mtarget) : envoi réel des SMS ; le code OTP devient alors aléatoire
MTARGET_URL=https://api-public-2.mtarget.fr/messages
MTARGET_USERNAME=
MTARGET_PASSWORD=
# Nom d'expéditeur alphanumérique, 11 caractères au maximum
MTARGET_SENDER=JERELAIS
MTARGET_TIMEOUT=30
MTARGET_VERIFY_SSL=true
# Facultatif : jeton du webhook des accusés de réception (https://<domaine>/api/v1/sms/dlr?token=…)
MTARGET_DLR_TOKEN=
PHONE_HASH_KEY=
SANCTUM_EXPIRATION=86400
# Local uniquement : code de double authentification fixe pour les démos
DEMO_TWO_FACTOR_CODE=

# Antivirus : clamav (production) ou fake (développement)
ANTIVIRUS_DRIVER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# FFmpeg (vignettes, durées, versions allégées)
FFMPEG_BINARIES=ffmpeg
FFPROBE_BINARIES=ffprobe

# Adresse qui reçoit les messages du formulaire de contact du site
JERELAIS_CONTACT_EMAIL=contact@jerelais.test

# Sauvegardes (jerelais:backup). En développement avec PostgreSQL en conteneur :
# BACKUP_COMMAND_PREFIX="docker exec -i jerelais-pgsql-1"
BACKUP_DISK=local
BACKUP_KEEP_DAYS=30
BACKUP_COMMAND_PREFIX=

# Proxys de confiance (répartiteur en production, 127.0.0.1 pour un tunnel local)
TRUSTED_PROXIES=

# Documentation de l API (/docs/swagger) ouverte sans compte hors local (préproduction, équipe mobile)
API_DOCS_PUBLIC=false
